# СӨХ Platform — орчны хувьсагч (Vercel → Project → Settings → Environment Variables)

# --- Өгөгдлийн сан (Neon Postgres; Vercel Marketplace-аас холбоход автоматаар нэмэгдэнэ) ---
DATABASE_URL=postgres://user:pass@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
# PG_POOL_MAX=3

# --- Сайтын хаяг (QPay callback-д) ---
PUBLIC_URL=https://your-project.vercel.app

# --- Vercel Cron хамгаалалт (дурын урт санамсаргүй текст) ---
CRON_SECRET=

# --- QPay v2 (тохируулаагүй бол production-д төлбөр хаалттай, хөгжүүлэлтэд mock) ---
QPAY_CLIENT_ID=
QPAY_CLIENT_SECRET=
QPAY_INVOICE_CODE=
# QPAY_URL=https://merchant-sandbox.qpay.mn
# PAYMENT_MOCK=1

# --- SMS / push: POST { to, text, id } хүлээж авдаг webhook (SMS provider-ийн adapter) ---
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=
PUSH_WEBHOOK_URL=
PUSH_WEBHOOK_TOKEN=

# --- eBarimt: PosAPI 3.0 руу дамжуулдаг bridge service (заавал биш) ---
EBARIMT_URL=
EBARIMT_TOKEN=

# --- Локал хөгжүүлэлт ---
# DATABASE_URL байхгүй бол PGlite (server/data/pg) ашиглана
# PGLITE_DIR=memory
# SEED_DEMO=0
