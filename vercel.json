{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "regions": ["sin1"],
  "rewrites": [{ "source": "/api/:path*", "destination": "/api?__p=:path*" }],
  "functions": {
    "api/index.js": {
      "maxDuration": 30,
      "includeFiles": "{server/migrations/**,js/layout.js,js/accounts.js}"
    }
  },
  "crons": [{ "path": "/api/cron/daily", "schedule": "0 1 * * *" }]
}
