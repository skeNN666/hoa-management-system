{
  "name": "sokh-platform",
  "private": true,
  "description": "СӨХ Platform — HTML · CSS · JavaScript · Three.js · Node + PostgreSQL · Cloudflare Workers",
  "scripts": {
    "start": "node server/server.js",
    "build": "node scripts/build.js",
    "seed": "node server/seed.js",
    "migrate": "node -e \"require('./server/db').ready().then(()=>require('./server/db').close())\"",
    "import:json": "node server/import-json.js",
    "test": "node tests/layout.test.js && node tests/accounts.test.js && node tests/server.test.js",
    "format": "npx prettier@3.3.3 --write \"css/**/*.css\" \"js/**/*.js\" \"*.html\" \"server/**/*.js\" \"scripts/*.js\" \"worker/*.js\" \"tests/*.js\"",
    "build:cf": "node scripts/build-worker.js",
    "cf:dev": "npx wrangler@4 dev",
    "cf:deploy": "npx wrangler@4 deploy"
  },
  "dependencies": {
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16"
  },
  "engines": {
    "node": ">=20"
  }
}
