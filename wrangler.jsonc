// СӨХ Platform — Cloudflare Worker тохиргоо.  npm run cf:dev  ·  npm run cf:deploy
// Анхны тохируулга: README.md → «Cloudflare дээр байршуулах»
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sokh-platform",
  "main": "worker/index.js",
  "compatibility_date": "2025-11-01",
  "compatibility_flags": ["nodejs_compat"],

  // dist/ + worker/migrations.gen.js-ийг үүсгэнэ (deploy, dev бүрт)
  "build": { "command": "node scripts/build-worker.js" },

  // Статик файл: Worker ажиллахгүй (үнэгүй, хязгааргүй). Зөвхөн /api/* Worker руу.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },

  // Neon Postgres (Hyperdrive-ийн id: npx wrangler hyperdrive create sokh-db --connection-string="…")
  "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "5509df5a20d040e78e7c202d71edb9d7" }],

  // ---- Хотхоны самбар (edge.html · worker/edge/) ------------------------------------------
  // D1: SQLite өгөгдлийн сан.  migration: npm run d1:migrate:local / npm run d1:migrate
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sokh-edge",
      "database_id": "ca876143-8095-4563-bf29-8e0e2ed9f1d8",
      "migrations_dir": "worker/edge/migrations"
    }
  ],
  // KV: түлхүүр → утга, дэлхий даяар хурдан уншина (самбарын кэш, баннер, /api/layouts кэш)
  "kv_namespaces": [{ "binding": "KV", "id": "73d4b5454eae4a78b984ccafc4db3139" }],
  // R2: файл/зургийн сан (S3-тэй адил) — самбарын болон үндсэн системийн (хүсэлт, map) зураг
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "sokh-files" }],
  // Durable Object: realtime чатын өрөө (WebSocket). Үнэгүй багцад SQLite-тэй DO л болно.
  // LIVE: үндсэн системийн realtime — хотхон бүрт нэг LiveHub (worker/live-hub.js)
  "durable_objects": {
    "bindings": [
      { "name": "CHAT", "class_name": "ChatRoom" },
      { "name": "LIVE", "class_name": "LiveHub" }
    ]
  },
  // DO-ийн migration: шинэ класс нэмэх бүрт шинэ tag (хуучныг нь бүү өөрчил)
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ChatRoom"] },
    { "tag": "v2", "new_sqlite_classes": ["LiveHub"] }
  ],

  // Өдөр бүр 01:00 UTC = 09:00 Улаанбаатар (нэхэмжлэл, сануулга, SLA, цэвэрлэгээ)
  "triggers": { "crons": ["0 1 * * *"] },

  // Нууц биш тохиргоо. Нууцуудыг: npx wrangler secret put CRON_SECRET (QPAY_*, SMS_* г.м.)
  "vars": {
    "NODE_ENV": "production",
    "SOKH_RUNTIME": "cloudflare",
    "SECURE_COOKIES": "1"
  },

  // Worker дээр PGlite хэрэггүй — bundle-д оруулахгүй
  "alias": { "@electric-sql/pglite": "./worker/pglite-stub.js" },

  "observability": { "enabled": true }
}
